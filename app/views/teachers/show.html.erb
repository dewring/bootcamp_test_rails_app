<% content_for :title, "Teacher Details" %>

<div class="info-block" style="margin-bottom: 24px;">
  <p><strong>NAME</strong> <%= @teacher.name %></p>
  <p><strong>ID</strong> <%= @teacher.id %></p>
</div>

<h3 class="grade-toggle">▼ CLASSES</h3>

<table class="grade-table">
  <thead>
    <tr>
      <th>SUBJECT</th>
    </tr>
  </thead>
  <tbody>
    <% @teacher.school_classes.each do |school_class| %>
      <tr>
        <td><%= school_class.subject %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<div style="text-align: right;">
  <% if user_signed_in? && admin_only? %>
    <%= link_to "EDIT", edit_teacher_path(@teacher), class: "wireframe-btn" %>
  <% end %>
</div>