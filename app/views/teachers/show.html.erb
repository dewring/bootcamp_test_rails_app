<% content_for :title, "Teacher Details" %>

<div style="margin-bottom: 20px;">
  <p><strong>NAME:</strong> <%= @teacher.name %></p>
</div>

<h3>▼ CLASSES</h3>
<table style="width: 100%; border-collapse: collapse; text-align: center;" border="1" cellpadding="8">
  <thead style="background-color: #f2f2f2;">
    <tr>
      <th>SUBJECT</th>
    </tr>
  </thead>
  <tbody>
    <% @teacher.school_classes.each do |school_class| %>
      <tr>
        <td><%= school_class.subject %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br><br>
<hr>
<div>
  <%= link_to "Edit Teacher", edit_teacher_path(@teacher), class: "wireframe-btn" %> |
  <%= link_to "Back to List", teachers_path, class: "wireframe-btn" %>
</div>