<% content_for :title, "New Teacher" %>

<h1>New Teacher</h1>

<%= form_with(model: @teacher) do |form| %>
  
  <div>
    <div style="width: 100px; height: 100px; border: 1px solid #000; border-radius: 50%; text-align: center; line-height: 100px; margin-bottom: 10px;">
      O
    </div>
    <%= form.file_field :avatar, id: "teacher_avatar_input" %>
    <button type="button" class="wireframe-btn" onclick="clearFileInput()">DELETE</button>
  </div>

  <br>

  <div class="form-group">
    <%= form.label :name, "NAME" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <div class="form-group">
    <label>ID</label>
    <input type="text" class="form-input" placeholder="XXXX" disabled>
  </div>

  <br>

  <div style="text-align: right; width: 380px;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>

<% end %>

<br>
<hr>
<div>
  <%= link_to "Back to teachers", teachers_path %>
</div>

<script>
  function clearFileInput() {
    const fileInput = document.getElementById('teacher_avatar_input');
    if (fileInput) {
      fileInput.value = "";
    }
  }
</script>