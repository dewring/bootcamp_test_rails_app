<% content_for :title, "New Teacher" %>

<%= form_with(model: @teacher) do |form| %>
  <div class="field-row">
    <span class="field-label">NAME</span>
    <%= form.text_field :name, class: "field-input" %>
  </div>

  <div class="field-row">
    <span class="field-label">ID</span>
    <input type="text" class="field-input" placeholder="auto" disabled>
  </div>

  <br>
  <div style="text-align: right;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>
<% end %>