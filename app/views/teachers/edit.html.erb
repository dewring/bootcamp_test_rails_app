<% content_for :title, "Editing Teacher" %>

<div class="school-header">
  Leika School
</div>

<h1>Editing Teacher</h1>

<%= form_with(model: @teacher) do |form| %>

  <div class="form-group">
    <%= form.label :name, "NAME" %>
    <%= form.text_field :name, class: "form-input" %>
  </div>

  <br>

  <div style="text-align: right; width: 380px;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>

<% end %>

<br>
<hr>
<div>
  <%= link_to "Back to Teacher", @teacher, class: "wireframe-btn" %>
</div>