<% content_for :title, "Edit Teacher" %>

<%= form_with(model: @teacher) do |form| %>
  <div class="field-row">
    <span class="field-label">NAME</span>
    <%= form.text_field :name, class: "field-input" %>
  </div>

  <div class="field-row">
    <span class="field-label">ID</span>
    <input type="text" class="field-input" value="<%= @teacher.id %>" disabled>
  </div>

  <br>
  <div style="text-align: right;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>
<% end %>

<br>
<%= render "shared/delete_button",
    path: teacher_path(@teacher),
    confirm_message: "선생님을 삭제하시겠습니까?" %>