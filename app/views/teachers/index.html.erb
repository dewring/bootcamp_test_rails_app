<% content_for :title, "Teachers" %>

<h1>Teachers List</h1>

<div id="teachers">
  <% @teachers.each do |teacher| %>
    <p style="border-bottom: 1px solid #eee; padding-bottom: 10px;">
      ○ <%= link_to teacher.name, teacher_path(teacher) %>
    </p>
  <% end %>
</div>

<br>
<%= link_to "Go to Create Page", new_teacher_path, class: "wireframe-btn" %>