<% content_for :title, "Class Details" %>

<div style="margin-bottom: 20px;">
  <p><strong>SUBJECT:</strong> <%= @school_class.subject %></p>
  <p><strong>TEACHER:</strong> <%= @school_class.teacher.name %></p>
</div>

<h3>▼ STUDENTS</h3>
<table style="width: 100%; border-collapse: collapse; text-align: center;" border="1" cellpadding="8">
  <thead style="background-color: #f2f2f2;">
    <tr>
      <th>NAME</th>
      <th>GRADE</th>
      <th>TERM</th>
    </tr>
  </thead>
  <tbody>
    <% @school_class.students.each do |student| %>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.grade %></td>
        <td><%= student.term %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br><br>
<hr>
<div>
  <%= link_to "Edit Class", edit_school_class_path(@school_class), class: "wireframe-btn" %> |
  <%= link_to "Back to List", school_classes_path, class: "wireframe-btn" %>
</div>