<% content_for :title, "Class Details" %>

<div class="info-block" style="margin-bottom: 24px;">
  <p><strong>SUBJECT</strong> <%= @school_class.subject %></p>
  <p><strong>TEACHER</strong> <%= @school_class.teacher.name %></p>
  <p><strong>ID</strong> <%= @school_class.id %></p>
</div>

<h3 class="grade-toggle">▼ STUDENTS</h3>

<table class="grade-table">
  <thead>
    <tr>
      <th>NAME</th>
      <th>GRADE</th>
      <th>TERM</th>
    </tr>
  </thead>
  <tbody>
    <% @school_class.students.each do |student| %>
      <tr>
        <td><%= student.name %></td>
        <td><%= student.grade %></td>
        <td><%= student.term %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>
<div style="text-align: right;">
  <% if user_signed_in? && can_manage_school_class?(@school_class) %>
    <%= link_to "EDIT", edit_school_class_path(@school_class), class: "wireframe-btn", data: { turbo: false } %>
  <% end %>
</div>