<% content_for :title, "Editing Class" %>

<h1>Editing School Class</h1>

<%= form_with(model: @school_class) do |form| %>

  <div class="form-group">
    <%= form.label :subject, "SUBJECT" %>
    <%= form.text_field :subject, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :teacher_id, "TEACHER" %>
    <%= form.collection_select :teacher_id, Teacher.all, :id, :name, {}, { class: "form-input" } %>
  </div>

  <br>

  <div style="text-align: right; width: 380px;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>

<% end %>

<br>
<hr>
<div>
  <%= link_to "Back to Class", @school_class, class: "wireframe-btn" %>
</div>