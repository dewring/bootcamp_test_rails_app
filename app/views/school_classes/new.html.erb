<% content_for :title, "New Class" %>

<%= form_with(model: @school_class) do |form| %>
  <div class="field-row">
    <span class="field-label">SUBJECT</span>
    <%= form.text_field :subject, class: "field-input" %>
  </div>

  <div class="field-row">
    <span class="field-label">TEACHER</span>
    <%= form.collection_select :teacher_id, Teacher.all, :id, :name,
        { prompt: "Select" }, { class: "field-input" } %>
  </div>

  <div class="field-row">
    <span class="field-label">ID</span>
    <input type="text" class="field-input" placeholder="auto" disabled>
  </div>

  <br>
  <div style="text-align: right;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>
<% end %>