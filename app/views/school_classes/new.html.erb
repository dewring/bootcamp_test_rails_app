<% content_for :title, "New Class" %>

<div class="school-header">
  Leika School
</div>

<h1>New School Class</h1>

<%= form_with(model: @school_class) do |form| %>
  
  <div class="form-group">
    <%= form.label :subject, "SUBJECT" %>
    <%= form.text_field :subject, class: "form-input", placeholder: "e.g. Math, Art" %>
  </div>

  <div class="form-group">
    <%= form.label :teacher_id, "TEACHER" %>
    <%= form.collection_select :teacher_id, Teacher.all, :id, :name, { prompt: "Select Teacher" }, { class: "form-input" } %>
  </div>

  <br>

  <div style="text-align: right; width: 380px;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>

<% end %>

<br>
<hr>
<div>
  <%= link_to "Back to classes", school_classes_path %>
</div>