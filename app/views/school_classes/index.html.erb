<% content_for :title, "Classes" %>

<h2 style="text-align: center; font-size: 16px; border-bottom: 1px solid #333; padding-bottom: 8px; margin-bottom: 20px;">
  classes
</h2>

<div class="list-container">
  <% @school_classes.each do |school_class| %>
    <div class="list-item">
      <%= link_to school_class.subject, school_class_path(school_class), class: "list-link", data: { turbo: false } %>
    </div>
  <% end %>
</div>

<br>
  <% if user_signed_in? && can_create_resource? %>
    <div style="text-align: center;">
      <%= link_to "NEW", new_school_class_path, class: "wireframe-btn", data: { turbo: false } %>
    </div>
  <% end %>