<% content_for :title, "Students" %>

<div class="school-header">
  Leika School
</div>

<h1>Students List</h1>

<div id="students">
  <% @students.each do |student| %>
    <p style="border-bottom: 1px solid #eee; padding-bottom: 10px;">
      ○ <%= link_to student.name, student_path(student) %>
    </p>
  <% end %>
</div>

<br>
<%= link_to "Go to Create Page", new_student_path, class: "wireframe-btn" %>