<% content_for :title, "Edit Registration" %>

<h2>Leika School</h2>
<hr>

<h1>Editing Registration</h1>

<%= form_with(model: @registration) do |form| %>

  <div>
    <%= form.label :student_id, "STUDENT" %>
    <%= form.collection_select :student_id, Student.all, :id, :name, {}, { disabled: true } %>
  </div>

  <br>

  <div>
    <%= form.label :school_class_id, "SCHOOL CLASS" %>
    <%= form.collection_select :school_class_id, SchoolClass.all, :id, :subject, {}, { disabled: true } %>
  </div>

  <br>

  <div>
    <%= form.label :point, "POINT" %>
    <%= form.number_field :point, min: 1, max: 100 %>
  </div>

  <br>

  <div>
    <%= form.label :booster, "BOOSTER" %>
    <%= form.number_field :booster, min: 1, max: 100 %>
  </div>

  <br>

  <div>
    <%= form.submit "UPDATE REGISTRATION" %>
  </div>

<% end %>

<br>
<hr>
<div>
  <%= link_to "Back to registrations", registrations_path %>
</div>