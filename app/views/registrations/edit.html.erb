<% content_for :title, "Edit Registration" %>

<%= form_with(model: @registration, url: student_registration_path(@registration), method: :patch) do |form| %>
  <div class="field-row">
    <span class="field-label">STUDENT</span>
    <%= form.collection_select :student_id, Student.all, :id, :name,
        {}, { class: "field-input", disabled: true } %>
  </div>

  <div class="field-row">
    <span class="field-label">CLASS</span>
    <%= form.collection_select :school_class_id, SchoolClass.all, :id, :subject,
        {}, { class: "field-input", disabled: true } %>
  </div>

  <div class="field-row">
    <span class="field-label">POINT</span>
    <%= form.number_field :point, min: 0, max: 100, class: "field-input" %>
  </div>

  <div class="field-row">
    <span class="field-label">BOOSTER</span>
    <%= form.number_field :booster, min: 0, max: 100, class: "field-input" %>
  </div>

  <% if @registration.errors.any? %>
    <div style="color: red; margin-top: 8px;">
      <ul>
        <% @registration.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <br>
  <div style="text-align: right;">
    <%= form.submit "SAVE", class: "wireframe-btn" %>
  </div>
<% end %>

<br>
<%= render "shared/delete_button",
    path: student_registration_path(@registration),
    confirm_message: "등록을 삭제하시겠습니까?" %>