<% content_for :title, "Edit Registration" %>

<div class="school-header">
  Leika School
</div>

<h1>Editing Registration</h1>

<%= form_with(model: @registration) do |form| %>

  <div class="form-group">
    <%= form.label :student_id, "STUDENT" %>
    <%= form.collection_select :student_id, Student.all, :id, :name, {}, { disabled: true, class: "form-input" } %>
  </div>

  <div class="form-group">
    <%= form.label :school_class_id, "SCHOOL CLASS" %>
    <%= form.collection_select :school_class_id, SchoolClass.all, :id, :subject, {}, { disabled: true, class: "form-input" } %>
  </div>

  <div class="form-group">
    <%= form.label :point, "POINT" %>
    <%= form.number_field :point, min: 1, max: 100, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :booster, "BOOSTER" %>
    <%= form.number_field :booster, min: 1, max: 100, class: "form-input" %>
  </div>

  <br>

  <div style="text-align: right; width: 380px;">
    <%= form.submit "UPDATE REGISTRATION", class: "wireframe-btn" %>
  </div>

<% end %>

<br>
<hr>
<div>
  <%= link_to "Back to registrations", registrations_path %>
</div>