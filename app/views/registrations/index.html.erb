<% content_for :title, "Registrations" %>

<div class="school-header">
  Leika School
</div>

<h1>Registrations List</h1>

<div id="registrations">
  <% @registrations.each do |registration| %>
    <p style="border-bottom: 1px solid #eee; padding-bottom: 10px;">
      <strong><%= registration.student&.name %></strong> - <%= registration.school_class&.subject %> 
      <br>
      POINT: <%= registration.point %> | BOOSTER: <%= registration.booster %>
      
      <br><br>
      <%= link_to "View Details", registration, class: "wireframe-btn", style: "font-size: 11px; padding: 4px 8px;" %> | 
      <%= link_to "Edit", edit_registration_path(registration), class: "wireframe-btn", style: "font-size: 11px; padding: 4px 8px;" %>
    </p>
  <% end %>
</div>

<br>
<%= link_to "New registration", new_registration_path, class: "wireframe-btn" %>