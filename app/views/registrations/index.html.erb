<% content_for :title, "Registrations" %>

<h2 style="text-align: center; font-size: 16px; border-bottom: 1px solid #333; padding-bottom: 8px; margin-bottom: 16px;">
  registrations
</h2>

<%# 필터 버튼 %>
<div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px;">
  <%= link_to "ALL", student_registrations_path,
      class: "wireframe-btn #{params[:school_class_id].blank? ? 'active' : ''}" %>
  <% @school_classes.each do |sc| %>
    <%= link_to sc.subject, student_registrations_path(school_class_id: sc.id),
        class: "wireframe-btn #{params[:school_class_id] == sc.id.to_s ? 'active' : ''}" %>
  <% end %>
</div>

<div class="list-container">
  <% @registrations.each do |registration| %>
    <div class="list-item">
      <strong><%= registration.student&.name %></strong> — <%= registration.school_class&.subject %>
      <br>
      <table class="grade-table" style="margin-top: 6px;">
        <thead>
          <tr>
            <th>POINT</th>
            <th>BOOSTER</th>
            <th>TOTAL</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= registration.point %></td>
            <td><%= registration.booster %></td>
            <td><%= registration.point + registration.booster %></td>
          </tr>
        </tbody>
      </table>
      <% if user_signed_in? && can_manage_registration?(registration) %>
        <div style="margin-top: 6px; text-align: right;">
          <%= link_to "EDIT", edit_student_registration_path(registration), class: "wireframe-btn", data: { turbo: false } %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<br>
<% if user_signed_in? && can_create_resource? %>
  <div style="text-align: center;">
    <%= link_to "NEW", new_student_registration_path, class: "wireframe-btn", data: { turbo: false } %>
  </div>
<% end %>