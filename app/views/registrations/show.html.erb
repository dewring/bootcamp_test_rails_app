<% content_for :title, "Registration Details" %>

<div class="info-block" style="margin-bottom: 24px;">
  <p><strong>STUDENT</strong> <%= @registration.student.name %></p>
  <p><strong>SUBJECT</strong> <%= @registration.school_class.subject %></p>
</div>

<table class="grade-table">
  <thead>
    <tr>
      <th>POINT</th>
      <th>BOOSTER</th>
      <th>TOTAL</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><%= @registration.point %></td>
      <td><%= @registration.booster %></td>
      <td><%= @registration.point + @registration.booster %></td>
    </tr>
  </tbody>
</table>

<br>
<div style="text-align: right;">
  <% if user_signed_in? %>
    <%= link_to "EDIT", edit_student_registration_path(@registration), class: "wireframe-btn" %>
  <% end %>
</div>